# Ambient Weather Network credentials
# Create these at https://ambientweather.net  ->  Account  ->  API Keys
# - Application Key: identifies this application (create once under "Developer")
# - API Key: grants access to YOUR station's data (create under "API Keys")

AMBIENT_APPLICATION_KEY=your_application_key_here
AMBIENT_API_KEY=your_api_key_here

# Optional: restrict the dashboard to a single station by MAC address.
# Leave blank to auto-select the first station on the account (your Kestrel).
AMBIENT_DEVICE_MAC=

# IANA timezone for the weather station. Used to group the daily rainfall
# history by station-local day (rain gauges reset at local midnight).
# Examples: America/Chicago, America/New_York, Europe/London.
AMBIENT_STATION_TZ=UTC

# Optional: Temp Stick (tempstickapi.com) API key. Enables the Temp Stick
# Sensors panel on the dashboard. Leave blank to hide that section.
TEMPSTICK_API_KEY=
# Unit the sensor reports last_temp in ('fahrenheit' or 'celsius').
# Temp Stick returns whichever the sensor is configured for in its app.
TEMPSTICK_UNIT=fahrenheit

# Server port
PORT=3000
